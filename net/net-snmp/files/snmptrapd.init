#!/bin/sh /etc/rc.common

START=50

USE_PROCD=1
PROG="/usr/sbin/snmptrapd"

CONFIGFILE="/var/run/snmptrapd.conf"

snmpd_trapsess_v3_add() {
	local cfg="$1"

	local host
	local port
	local target
	local inform
	local username
	local security_level
	local auth_type
	local auth_pass
	local privacy_type
	local privacy_pass
	local engineid
	local args

	config_get host "$cfg" host
	[ -n "$host" ] || {
		echo "skipping section '$cfg' 'host' missing"
		return 0
	}

	config_get username "$cfg" username
	[ -n "$username" ] || {
		echo "skipping section '$cfg' 'username' missing"
		return 0
	}

	config_get port "$cfg" port 162
	config_get_bool inform "$cfg" inform 0
	config_get auth_type "$cfg" auth_type
	config_get auth_pass "$cfg" auth_pass
	config_get privacy_type "$cfg" privacy_type
	config_get privacy_pass "$cfg" privacy_pass
	config_get engineid "$cfg" engineid

	config_get security_level "$cfg" security_level
	# derive security level for sections without 'security_level'
	if [ -z "$security_level" ]; then
		if [ -z "$auth_pass" ]; then
			security_level="noAuthNoPriv"
		elif [ -n "$privacy_type" ] && [ -n "$privacy_pass" ]; then
			security_level="authPriv"
		else
			security_level="authNoPriv"
		fi
	fi

	args="-v 3 -u $username -l $security_level"
	[ "$inform" -eq 1 ] && args="-Ci $args"

	case "$security_level" in
	noAuthNoPriv)
		;;
	authNoPriv|authPriv)
		[ -z "$auth_type" ] && {
			echo "skipping section '$cfg' 'auth_type' missing"
			return 0
		}
		[ "${#auth_pass}" -lt 8 ] && {
			echo "skipping section '$cfg' 'auth_pass' requires a min length of 8"
			return 0
		}
		args="$args -a $auth_type -A \"$auth_pass\""
		;;
	*)
		echo "skipping section '$cfg' wrong 'security_level=$security_level' configured"
		return 0
		;;
	esac

	if [ "$security_level" = "authPriv" ]; then
		[ -z "$privacy_type" ] && {
			echo "skipping section '$cfg' 'privacy_type' missing"
			return 0
		}
		[ "${#privacy_pass}" -lt 8 ] && {
			echo "skipping section '$cfg' 'privacy_pass' requires a min length of 8"
			return 0
		}
		args="$args -x $privacy_type -X \"$privacy_pass\""
	fi

	[ -n "$engineid" ] && args="$args -e $engineid"

	case "$host" in
	*:*) target="udp6:[$host]:$port" ;;
	*) target="udp:$host:$port" ;;
	esac

	echo "trapsess $args $target" >> $CONFIGFILE
}

snmptrapd_setup_fw_rules() {
	local net="$1"
	local zone

	zone=$(fw3 -q network "$net" 2>/dev/null)

	local handled_zone
	for handled_zone in $HANDLED_SNMPTRAPD_ZONES; do
		[ "$handled_zone" = "$zone" ] && return
	done

	json_add_object ""
	json_add_string type rule
	json_add_string src "$zone"
	json_add_string proto udp
	json_add_string dest_port 162
	json_add_string target ACCEPT
	json_close_object

	HANDLED_SNMPTRAPD_ZONES="$HANDLED_SNMPTRAPD_ZONES $zone"
}

start_service() {
	[ -f "$CONFIGFILE" ] && rm -f "$CONFIGFILE"

	config_load snmpd

	config_get_bool snmptrapd_enabled general enabled 1
	[ "$snmptrapd_enabled" -eq 0 ] && return

	touch "$CONFIGFILE"
	chmod 600 "$CONFIGFILE"
	config_foreach snmptrapd_snmpv3_add v3

	procd_open_instance

	procd_set_param command $PROG -Lf /dev/null -f -c "$CONFIGFILE"
	procd_set_param respawn
	procd_set_param file /etc/config/snmpd

	procd_open_data

	json_add_array firewall
	config_list_foreach general network snmptrapd_setup_fw_rules
	json_close_array

	procd_close_data

	procd_close_instance
}

service_stopped() {
	[ -f "$CONFIGFILE" ] || return
	rm -f "$CONFIGFILE"
	procd_set_config_changed firewall
}

reload_service() {
	restart
}

service_triggers() {
	procd_add_reload_trigger 'snmpd'
}

service_started() {
	[ "$snmptrapd_enabled" -eq 0 ] && return
	procd_set_config_changed firewall
}
